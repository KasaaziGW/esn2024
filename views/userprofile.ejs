<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('templates/head'); %>
    <title>Share Status</title>
</head>
<body>
    <%- include('templates/header'); %>
    <main class="d-flex flex-nowrap" style="height:600px;">
        <%- include('templates/nav'); %>       

        <div class="userprofile-container">
        <!-- Profile Form Section -->
            <section class="userprofile-form-section">
                <form id="userprofile-form" method="POST" action="/update-profile">
                    <h2>Edit Profile</h2>
                    
                    <!-- Full Name and Email -->
                    <div class="userprofile-form-row">
                        <label for="userprofile-fullname">Full Name</label>
                        <input type="text" id="userprofile-fullname" name="fullname" value="John Doe" required>

                        <label for="userprofile-email">User Name</label>
                        <input type="email" id="userprofile-email" name="email" value="johndoe@example.com" required>
                    </div>

                    <!-- Role and Status (for Admins only) -->
                    <div class="userprofile-form-row">
                        <label for="userprofile-role">Role</label>
                        <select id="userprofile-role" name="role" disabled>
                            <option value="User">User</option>
                            <option value="Admin" selected>Admin</option>
                            <option value="Coordinator">Coordinator</option>
                        </select>

                        <label for="userprofile-status">Status</label>
                        <select id="userprofile-status" name="status" disabled>
                            <option value="Active" selected>Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>

                    <!-- Password and Confirm Password -->
                    <div class="userprofile-form-row">
                        <label for="userprofile-password">Password</label>
                        <input type="password" id="userprofile-password" name="password" placeholder="Enter new password">

                        <label for="userprofile-confirm-password">Confirm Password</label>
                        <input type="password" id="userprofile-confirm-password" name="confirmPassword" placeholder="Confirm new password">
                    </div>

                    <!-- Submit Button -->
                    <div class="userprofile-form-row userprofile-button-row">
                        <button type="submit" class="userprofile-submit-btn">Update Profile</button>
                    </div>
                </form>
            </section>
        </div>  
    </main>
    <%- include('templates/footer'); %>
    <script src="js/chat.js"></script>    
</body>
</html>
