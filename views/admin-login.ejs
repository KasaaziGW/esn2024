<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('templates/head') %>  
  <title>Admin Login</title>
</head>
<body>
    <%- include('templates/header') %>      
    <main class="container">
        <div class="wrapper fadeInDown">
            <div class="formContent">
                <div>
                    <img src="images/login.png" id="icon" alt="User icon">
                </div>
                <%- include('templates/errors') %>
                <%- include('templates/success') %>
                <form method="POST" action="/processLogin">
                        <input type="text" name="username" required placeholder="Enter your username here." autocomplete="off">
                        <input type="password" name="password" required placeholder="Enter your password here">
                        <input type="submit" name="submit">
                </form>
                
            </div>
        </div>
    </main>
    <%- include('templates/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
</html>